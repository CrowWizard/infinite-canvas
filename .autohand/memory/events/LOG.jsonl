{"version":1,"eventId":"65264491-572a-4093-ae39-c5038a3c0948","operation":"update","level":"project","memoryId":"7a18b82b","occurredAt":"2026-08-27T13:50:16.317Z","entry":{"id":"7a18b82b","content":"项目已决定采用 PostgreSQL 专用后端构建：移除 SQLite/MySQL 驱动、相关配置兼容逻辑和模块依赖，默认使用 PostgreSQL DSN。","createdAt":"2026-08-27T13:48:49.556Z","updatedAt":"2026-08-27T13:50:16.273Z","tags":["database","postgresql","build","go"],"source":"turn-reflection"}}
