{"version":1,"eventId":"6c7fdfad-19f4-4f24-a46d-6514ac7d55b1","operation":"create","level":"project","memoryId":"7a18b82b","occurredAt":"2026-08-27T13:48:49.600Z","entry":{"id":"7a18b82b","content":"该项目已决定采用 PostgreSQL 专用后端构建：数据库初始化、默认配置、依赖和文档应只保留 PostgreSQL，不再兼容 SQLite/MySQL。","createdAt":"2026-08-27T13:48:49.556Z","updatedAt":"2026-08-27T13:48:49.556Z","tags":["database","postgresql","build"],"source":"turn-reflection"}}
