{"version":1,"eventId":"7e8736d8-826d-49b4-a101-35f16221e643","operation":"update","level":"project","memoryId":"46c56aa8","occurredAt":"2026-08-27T17:07:51.179Z","entry":{"id":"46c56aa8","content":"生产部署采用同域架构：Nginx 直接托管 Next.js 静态导出目录 `web/out`，并将 `/api/` 反向代理到本机 Go 服务 `:8080`；前端不再运行 Next.js 服务端或使用 Next.js API 代理。","createdAt":"2026-08-27T14:31:19.847Z","updatedAt":"2026-08-27T17:07:51.124Z","tags":["deployment","nginx","static-export","api"],"source":"turn-reflection"}}
