{
  "permissions": {
    "allowList": [
      "read_file:web/src",
      "read_file:web/*",
      "read_file:model",
      "read_file:service",
      "write_file:docs/architecture.md",
      "write_file:docs/*",
      "read_file:docs/index.md",
      "read_file:docs/*",
      "read_file:*",
      "git_apply_patch:*",
      "run_command:git diff -- go.mod",
      "write_file:repository/db.go",
      "write_file:repository/*",
      "write_file:config/config.go",
      "write_file:config/*",
      "write_file:go.mod",
      "shell:go mod edit -droprequire github.com/glebarez/sqlite -droprequire github.com/go-sql-driver/mysql -droprequire gorm.io/driver/mysql && go mod tidy",
      "shell:go test ./config",
      "shell:go build -o /tmp/infinite-canvas-server .",
      "write_file:web/src/app/(user)/canvas/[id]/canvas-client-page.tsx",
      "write_file:web/src/app/(user)/canvas/[id]/*",
      "write_file:web/src/app/(user)/canvas/canvas-client-page.tsx",
      "write_file:web/src/app/(user)/canvas/*",
      "write_file:web/src/app/(user)/page.tsx",
      "write_file:web/src/app/(user)/*",
      "shell:rg -n 'from \"\\.\\./' 'web/src/app/(user)/canvas/canvas-client-page.tsx'",
      "write_file:web/src/app/api/[...path]/route.ts",
      "write_file:web/src/app/api/[...path]/*",
      "write_file:web/next.config.ts",
      "write_file:web/*",
      "shell:bun run build",
      "shell:bun install",
      "run_command:git remote -v",
      "run_command:git remote set-url origin git@github.com:CrowWizard/infinite-canvas.git && git remote -v",
      "create_directory:.autohand/plans",
      "create_directory:.autohand/*",
      "write_file:.autohand/plans/newapi-integration.md",
      "write_file:.autohand/plans/*",
      "git_switch:*",
      "git_add:*",
      "git_commit:*"
    ],
    "denyList": []
  },
  "version": 1
}
